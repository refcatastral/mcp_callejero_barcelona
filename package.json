{
  "name": "mcp-callejero-barcelona",
  "version": "1.0.0",
  "mcpName": "io.github.refcatastral/mcp-callejero-barcelona",
  "description": "Servidor MCP (Model Context Protocol) oficial de RefCatastral.es para consultar el callejero de Barcelona, direcciones postales, cruces, barrios, distritos, códigos INE y referencias catastrales usando APIs públicas (GeoBCN, Open Data BCN, ICGC y CartoCiudad).",
