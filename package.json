    "start": "node index.js",
    "test": "node test.js"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "barcelona",
    "callejero",
    "carrerer",
    "geobcn",
    "opendata-bcn",
    "icgc",
    "catastro",
    "refcatastral",
    "geocoding",
    "gis"
  ],
  "author": "RefCatastral.es <info@refcatastral.es> (https://refcatastral.es)",
  "license": "MIT",
  "homepage": "https://refcatastral.es/barcelona/barcelona/",
